# Frontend API URL
# Local: http://localhost:5000/api
# Production: https://YOUR-BACKEND-DOMAIN/api
VITE_API_URL=http://localhost:5000/api

# Backend server
NODE_ENV=production
PORT=5000

# AWS RDS MySQL
# Example host: portfolio-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_HOST=YOUR_RDS_ENDPOINT
DB_PORT=3306
DB_NAME=YOUR_RDS_DATABASE_NAME
DB_USER=YOUR_RDS_MASTER_USERNAME
DB_PASSWORD=YOUR_RDS_MASTER_PASSWORD

# Use a long random value in production
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET
